# Encrypted SomaCloud backups
# These contain password hashes, node setup tokens and the Docker node SSH
# private key, in AES-256-CBC encrypted form. Passphrase is required to open.
*.tar.gz.enc

# Unencrypted backup artifacts stay local (see scripts/backup_encrypt.sh).
backups/*.sqlite3
backups/*.sqlite3.gz
backups/*.tar.gz
backups/*.json
backups/*.json.gz